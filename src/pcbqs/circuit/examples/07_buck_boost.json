{
 "format": 2,
 "name": "Inverting buck-boost, 12 V to -15 V",
 "description": "The inductor is charged from the input and discharged into a negative output",
 "parameters": {
  "fsw": 200000.0,
  "vin": 12,
  "vout": -15,
  "iout": 0.5
 },
 "parts": [
  {
   "ref": "V1",
   "type": "source",
   "nodes": [
    "in",
    "0"
   ],
   "dc_V": "vin",
   "R_ohm": 0.02
  },
  {
   "ref": "C1",
   "type": "capacitor",
   "nodes": [
    "in",
    "0"
   ],
   "value": "22u",
   "ESR_ohm": 0.005
  },
  {
   "ref": "Q1",
   "type": "switch",
   "nodes": [
    "in",
    "sw"
   ],
   "drive": "pwm",
   "model": {
    "type": "switch",
    "Ron_ohm": 0.03
   }
  },
  {
   "ref": "L1",
   "type": "inductor",
   "nodes": [
    "sw",
    "0"
   ],
   "value": "47u",
   "DCR_ohm": 0.05
  },
  {
   "ref": "D1",
   "type": "diode",
   "nodes": [
    "out",
    "sw"
   ],
   "model": {
    "Vf_V": 0.45,
    "If_A": 1,
    "R_ohm": 0.03,
    "Cj_F": "100p"
   }
  },
  {
   "ref": "C2",
   "type": "capacitor",
   "nodes": [
    "out",
    "0"
   ],
   "value": "47u",
   "ESR_ohm": 0.01
  },
  {
   "ref": "R1",
   "type": "load",
   "nodes": [
    "out",
    "0"
   ],
   "resistance_ohm": "abs(vout)/iout"
  }
 ],
 "drives": {
  "pwm": {
   "frequency_Hz": "fsw",
   "duty": 0.5
  }
 },
 "probes": {
  "vout": {
   "voltage": [
    "out",
    "0"
   ]
  },
  "vsw": {
   "voltage": [
    "sw",
    "0"
   ]
  },
  "il": {
   "current": "L1"
  }
 },
 "measures": {
  "vout_avg": {
   "avg": "vout"
  },
  "il_ripple": {
   "pp": "il"
  }
 },
 "targets": [
  {
   "adjust": "drives.pwm.duty",
   "range": [
    0.05,
    0.9
   ],
   "initial": "abs(vout)/(abs(vout)+vin)",
   "measure": "vout_avg",
   "value": "vout"
  }
 ]
}